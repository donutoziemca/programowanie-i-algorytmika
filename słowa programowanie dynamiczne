def np(w1,w2):
	print(w1,w2)
	m = len(w1)
	n = len(w2)
	tabela  = []
	for i in range(n+1):
		tabela.append([0 for j in range(m+1)])
	for k in range(1,n+1):
		for k2 in range(1,m+1):
			if w1[k2-1] == w2[k-1]:
				tabela[k][k2] = tabela[k-1][k2-1] + 1
			else:
				tabela[k][k2] = max(tabela[k-1][k2],tabela[k][k2-1])
	return tabela[-1][-1]
print(np("samoloto","lato"))
