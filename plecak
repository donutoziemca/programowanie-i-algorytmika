#+zerowy wiersz
przedmioty = [1,2,3,4,5,6]
n = len(przedmioty)
W = 7
zerowa = []
def macierz_zero(i,j):
	zerowa = []
	for _ in range(i+1):
		zerowa.append([0]*(j+1))
	return zerowa

P = macierz_zero(n,W)
Q = macierz_zero(n,W)
def wypisanie(macierz):
	for wiersz in macierz:
		for element in wiersz:
			print(f'{element:5}',end='')
		print()
#pz = T[2][0] wartość drugiego przedmiotu
#wz = T[2][1] waga drugiego przedmiotu
T = [[0,0],[7,2],[4,4],[5,3],[3,4],[6,5],[2,1]]
#def pakowanie():
for i in range(1,n+1):
	for j in range(1,W+1):
		if T[i][1] > j:
			 P[i][j] = P[i-1][j]
			 Q[i][j] = 0
		else:
			P[i][j] = max(P[i-1][j],P[i-1][j-T[i][1]]+T[i][0])
			if P[i-1][j] > P[i-1][j-T[i][1]]+T[i][0]:
				Q[i][j] = 0
			else:
				Q[i][j] = 1
wypisanie(P)
print('\n')
wypisanie(Q)
