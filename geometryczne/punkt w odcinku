def det(p,q,r):
	xp, yp = p
	xq, yq = q
	xr, yr = r
	return xr*(yp - yq) - xq*(yp - yr) + xp*(yq - yr)
def sgn(a):
	if a > 0:
		return 1
	if a < 0:
		return -1
	return 0
