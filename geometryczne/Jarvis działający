def det(p,q,r):
	xp, yp = p
	xq, yq = q
	xr, yr = r
	return xr*(yp - yq) - xq*(yp - yr) + xp*(yq - yr)
def orientation(p, a, b):
    """
    Zwraca:
    > 0  - skręt w lewo
    < 0  - skręt w prawo
    = 0  - punkty współliniowe
    """
    return (a[0] - p[0]) * (b[1] - p[1]) - (a[1] - p[1]) * (b[0] - p[0])
def dystans(p, x):
    return (x[0] - p[0])**2 + (x[1] - p[1])**2
def pierwszy(p):
	otoczka = []
	pom = p[0]
	for i in range(1,len(p)):
		if p[i][1] < p[i-1][1]:
			pom = p[i]
	return pom
def nastepny(lista, punkt):

    nowy = None

    for i in lista:
        if i == punkt:
            continue

        if nowy is None:
            nowy = i
            continue

        orient = orientation(punkt,nowy, i)

        if orient > 0:
            nowy = i
        elif orient == 0:
            if dystans(punkt, i) > dystans(punkt, nowy):
                nowy = i

    return nowy
